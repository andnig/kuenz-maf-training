{
  "name": "Künz MAF Training · Python 3.13",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "postCreateCommand": "bash .devcontainer/vorbereiten.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "lessons/ue08_model.py"
      ]
    }
  }
}
